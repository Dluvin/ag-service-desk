generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  createdAt           DateTime @default(now())
  revealAppId         String?
  revealUsername      String?
  revealPassword      String?
  revealBaseUrl       String   @default("https://fim.api.us.fleetmatics.com")
  revealOnsiteMeters  Int      @default(400)
  birdApiKey          String?
  birdFrom            String?
  birdWorkspaceId     String?
  birdChannelId       String?
  birdSmsEnabled      Boolean  @default(false)
  logoMimeType        String?
  logoFileName        String?
  paused              Boolean  @default(false)
  signupStatus        String   @default("ACTIVE")
  signupPhone         String?
  signupTitle         String?
  signupAddress       String?
  signupCity          String?
  signupRegion        String?
  signupPostalCode    String?
  signupStaffCount    String?
  signupNotes         String?
  trialEndsAt         DateTime?
  stripeCustomerId    String?
  stripeSubscriptionId String?
  stripeCheckoutUrl   String?
  // STARTER | SHOP | ENTERPRISE — prices and defaults in lib/plans.ts. Existing orgs default to SHOP.
  plan                String   @default("SHOP")
  ocrTemplateKey      String   @default("irrigation-service-order")
  ocrFieldNotes       String?
  ocrEnabled          Boolean? // null = derive from plan
  formsEnabled        Boolean? // null = derive from plan
  ocrBoxesConfirmedAt DateTime?
  ocrFirstScanAt      DateTime?
  ocrFieldListReviewedAt DateTime?
  mapsEnabled         Boolean? // null = derive from plan
  gpsEnabled          Boolean  @default(false)
  gpsProvider         String   @default("NONE") // NONE | REVEAL | VERIZON | OTHER
  revealGps           Boolean  @default(false) // Shop Reveal add-on
  maxStores           Int?     // null = derive from plan
  includedUsers       Int?     // null = derive from plan
  extraSeatCents      Int?     // null = derive from plan
  monthlyCents        Int?     // null = derive from plan
  users               User[]
  farmers             Farmer[]
  pivots              Pivot[]
  tickets             Ticket[]
  inspections         StartupInspection[]
  startupChecks       StartupCheckTemplate[]
  catalogParts        CatalogPart[]
  catalogLabor        CatalogLabor[]
  catalogEquipment    CatalogEquipment[]
  stores              Store[]
  revealVehicles      RevealVehicle[]
  assetTypes          AssetType[]
  assets              Asset[]
  farms               Farm[]
  ocrSamples          OrgOcrSample[]
}

model OrgOcrSample {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  createdAt      DateTime     @default(now())
}

model RevealVehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  name           String
  active         Boolean      @default(true)
  showOnMap      Boolean      @default(true)
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  syncedAt       DateTime     @default(now())

  @@unique([organizationId, number])
}

model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  phone          String?
  createdAt      DateTime     @default(now())
  farmers        Farmer[]
  users          User[]
  tickets        Ticket[]
  vehicles       RevealVehicle[]

  @@unique([organizationId, name])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  passwordHash   String
  name           String
  role           String
  phone          String?
  farmerId       String?
  farmer         Farmer?      @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  tickets        Ticket[]              @relation("TechnicianTickets")
  updates        TicketUpdate[]
  photos         TicketPhoto[]
  partsLogged    TicketPart[]
  laborLogged    TicketLabor[]
  equipmentLogged TicketEquipment[]
  inspections           StartupInspection[]   @relation("Inspector")
  revealVehicleNumber   String?
  siteVisits            SiteVisit[]
  pivotNotes            PivotNote[]
  pivotDocuments        PivotDocument[]
  passwordResets        PasswordResetToken[]
  dispatchView          String                @default("LIST")
  locale                String                @default("en")
  lastSeenAt            DateTime?
  lastPath              String?
  lastLatitude          Float?
  lastLongitude         Float?
  createdAt             DateTime              @default(now())

  @@unique([organizationId, email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Farmer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId        String?
  store          Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt       DateTime         @default(now())
  users           User[]
  pivots          Pivot[]
  assets          Asset[]
  tickets         Ticket[]
  contacts        FarmerContact[]
  farms           Farm[]
  farmAssignments FarmAssignment[]
}

model Farm {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmerId         String
  farmer           Farmer           @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  primaryContactId String?
  primaryContact   FarmerContact?   @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  name             String
  location         String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime         @default(now())
  pivots           Pivot[]
  assets           Asset[]
  assignments      FarmAssignment[]

  @@index([organizationId, farmerId])
}

model FarmAssignment {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  startYear Int
  endYear   Int?
  createdAt DateTime @default(now())

  @@index([farmId])
  @@index([farmerId])
}

model FarmerContact {
  id              String   @id @default(cuid())
  farmerId        String
  farmer          Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  phone           String?
  createdAt       DateTime @default(now())
  primaryForFarms Farm[]
}

model Pivot {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmerId       String
  farmer         Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmId         String?
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  name           String
  latitude       Float
  longitude      Float
  locationNote   String?
  serialNumber   String?
  createdAt      DateTime     @default(now())
  tickets        Ticket[]
  inspections    StartupInspection[]
  notes          PivotNote[]
  documents      PivotDocument[]

  @@index([farmId])
}

model PivotDocument {
  id        String   @id @default(cuid())
  pivotId   String
  pivot     Pivot    @relation(fields: [pivotId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  createdAt DateTime @default(now())

  @@index([pivotId])
}

model PivotNote {
  id        String   @id @default(cuid())
  pivotId   String
  pivot     Pivot    @relation(fields: [pivotId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model AssetType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  kind           String       @default("GENERIC")
  builtIn        Boolean      @default(false)
  sortOrder      Int          @default(100)
  createdAt      DateTime     @default(now())
  assets         Asset[]

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
}

model Asset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetTypeId    String
  assetType      AssetType    @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  farmerId       String
  farmer         Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  farmId         String?
  farm           Farm?        @relation(fields: [farmId], references: [id], onDelete: SetNull)
  name           String
  latitude       Float
  longitude      Float
  locationNote   String?
  serialNumber   String?
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, assetTypeId])
  @@index([farmerId])
  @@index([farmId])
}

model Ticket {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmerId       String
  farmer         Farmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  pivotId        String
  pivot          Pivot         @relation(fields: [pivotId], references: [id], onDelete: Cascade)
  technicianId   String?
  technician     User?         @relation("TechnicianTickets", fields: [technicianId], references: [id], onDelete: SetNull)
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  number         Int
  title          String
  description    String
  status         String        @default("OPEN")
  priority       String        @default("NORMAL")
  invoiceNumber  String?
  invoiceAmount  Float?
  scheduledAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  updates        TicketUpdate[]
  photos         TicketPhoto[]
  parts          TicketPart[]
  labor          TicketLabor[]
  equipment      TicketEquipment[]
  inspections    StartupInspection[]
  siteVisits     SiteVisit[]

  @@unique([organizationId, number])
}

model SiteVisit {
  id               String    @id @default(cuid())
  ticketId         String
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId     String?
  technician       User?     @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  vehicleNumber    String
  startedAt        DateTime
  endedAt          DateTime?
  lastSeenAt       DateTime
  metersFromPivot  Float?

  @@index([ticketId])
  @@index([technicianId, endedAt])
}

model CatalogPart {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  sku             String?
  description     String?
  itemType        String?
  price           Float?
  cost            Float?
  quantityOnHand  Float?
  active          Boolean      @default(true)
  source          String       @default("MANUAL")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ticketParts     TicketPart[]

  @@unique([organizationId, name])
}

model TicketPart {
  id             String        @id @default(cuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogPartId  String?
  catalogPart    CatalogPart?  @relation(fields: [catalogPartId], references: [id], onDelete: SetNull)
  name           String
  quantity       Float
  sku            String?
  unitPrice      Float?
  createdAt      DateTime      @default(now())
}

model CatalogLabor {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  itemType       String?
  rate           Float?
  active         Boolean       @default(true)
  source         String        @default("MANUAL")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  ticketLabor    TicketLabor[]

  @@unique([organizationId, name])
}

model TicketLabor {
  id              String         @id @default(cuid())
  ticketId        String
  ticket          Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogLaborId  String?
  catalogLabor    CatalogLabor?  @relation(fields: [catalogLaborId], references: [id], onDelete: SetNull)
  name            String
  hours           Float
  sku             String?
  unitRate        Float?
  createdAt       DateTime       @default(now())
}

model CatalogEquipment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  description    String?
  itemType       String?
  rate           Float?
  active         Boolean           @default(true)
  source         String            @default("MANUAL")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  ticketEquipment TicketEquipment[]

  @@unique([organizationId, name])
}

model TicketEquipment {
  id                  String            @id @default(cuid())
  ticketId            String
  ticket              Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogEquipmentId  String?
  catalogEquipment    CatalogEquipment? @relation(fields: [catalogEquipmentId], references: [id], onDelete: SetNull)
  name                String
  hours               Float
  sku                 String?
  unitRate            Float?
  createdAt           DateTime          @default(now())
}

model StartupInspection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pivotId        String
  pivot          Pivot        @relation(fields: [pivotId], references: [id], onDelete: Cascade)
  seasonYear     Int
  status         String       @default("IN_PROGRESS")
  inspectorId    String?
  inspector      User?        @relation("Inspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  ticketId       String?
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  checks         StartupCheck[]

  @@unique([pivotId, seasonYear])
}

model StartupCheck {
  id            String             @id @default(cuid())
  inspectionId  String
  inspection    StartupInspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checkKey      String
  label         String             @default("")
  detail        String             @default("")
  sortOrder     Int                @default(0)
  result        String             @default("PENDING")
  notes         String?

  @@unique([inspectionId, checkKey])
}

model StartupCheckTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkKey       String
  label          String
  detail         String       @default("")
  sortOrder      Int          @default(0)

  @@unique([organizationId, checkKey])
}

model TicketUpdate {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  status    String?
  createdAt DateTime @default(now())
  photos    TicketPhoto[]
}

model TicketPhoto {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  updateId  String?
  update    TicketUpdate? @relation(fields: [updateId], references: [id], onDelete: SetNull)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  createdAt DateTime      @default(now())

  @@index([ticketId])
}
